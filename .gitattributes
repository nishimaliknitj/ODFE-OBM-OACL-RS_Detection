# Auto-detect text files, normalize line endings to LF
* text=auto eol=lf

*.py text diff=python
*.md  text
*.yaml text
*.yml  text
*.sh  text eol=lf

# Treat model / binary files as binary (avoid diff noise / corruption)
*.pt   binary
*.pth  binary
*.onnx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary

# Track large files via Git LFS (optional, uncomment if using LFS)
# *.pt filter=lfs diff=lfs merge=lfs -text
# *.pth filter=lfs diff=lfs merge=lfs -text
