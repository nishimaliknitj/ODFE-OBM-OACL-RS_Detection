# Copy this file to .env and fill in your own values. Never commit .env itself.

# Weights & Biases (optional experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=odfe-obm-oacl-rs-detection
WANDB_ENTITY=

# Dataset roots (override defaults in configs/*.yaml)
DIOR_ROOT=./data/DIOR
DOTA_ROOT=./data/DOTA
FAIR1M_ROOT=./data/FAIR1M

# Checkpoint / output directories
CHECKPOINT_DIR=./checkpoints
LOG_DIR=./logs
RESULTS_DIR=./results

# Hardware
CUDA_VISIBLE_DEVICES=0
